# Copy to .env.deployment (gitignored). deploy.sh reads it automatically.
export MTA_PROXY_SSH_HOST=proxy-server
# Optional: defaults to the SSH account's HOME/mta-proxy.
# export MTA_PROXY_ROOT=/srv/mta-proxy
# Optional: defaults to tailscale status --json Self.DNSName on the server.
# Use a DNS hostname without a scheme, path, port, or trailing dot.
# export MTA_PROXY_PUBLIC_HOST=proxy.example.ts.net
# verify_hosted.py and test_smoke.py read this from the environment.
# Source this file before running them; omit the /mta suffix.
export MTA_PROXY_BASE=https://proxy.example.ts.net
# Server settings (not forwarded by deploy.sh; configure systemd separately):
# MTA_PROXY_BIND=127.0.0.1
# MTA_PROXY_PORT=8087
# MTA_PROXY_STATE defaults to the server account's HOME/mta-proxy/state.
